# ─────────────────────────────────────────────────────────────────────────────
# TradePro — Docker environment variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is listed in .gitignore — NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=tradeprodb
POSTGRES_USER=tradepro
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT (must be at least 32 characters / 256 bits) ──────────────────────────
JWT_SECRET=change_me_at_least_32_characters_long_secret_key

# ── Mail / OTP ───────────────────────────────────────────────────────────────
# Option A — Gmail SMTP (use an App Password, not your real Gmail password)
# Generate one at https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# Option B — Resend (better deliverability, free 100 emails/day)
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Optional overrides ───────────────────────────────────────────────────────
# JWT_EXPIRATION=86400000          # access token  — 24 h in ms (default)
# JWT_REFRESH_EXPIRATION=604800000 # refresh token —  7 d in ms (default)
# TOTP_ISSUER=TradePro             # shown in authenticator apps (default)
