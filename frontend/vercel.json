{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://REPLACE_WITH_YOUR_RAILWAY_URL/api/:path*"
    },
    {
      "source": "/((?!api|backend).*)",
      "destination": "/index.html"
    }
  ]
}
